[Unit]
Description=Trading - Phan tich co phieu VN50 & Ngan hang (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
User=trading
Group=trading
WorkingDirectory=/opt/Claude-CK
ExecStart=/opt/Claude-CK/venv/bin/streamlit run app.py \
    --server.port 8501 \
    --server.address 127.0.0.1 \
    --server.baseUrlPath trading \
    --server.headless true
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
